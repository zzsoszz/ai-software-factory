{
  "version": 1,
  "description": "本机 Codex 软件工厂",
  "project": {
    "owner": "zzsoszz",
    "title": "AI Software Factory",
    "number": 1
  },
  "worker_backend": "workflow",
  "host": "codex",
  "model_tier": "medium",
  "codex": {
    "model": null
  },
  "calibration": {
    "enabled": false,
    "allowed_skill_paths": []
  },
  "target": {
    "type": "repo",
    "url": null
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/zzsoszz/ai-software-factory"
  },
  "base_branch": "main",
  "timezone": "Asia/Shanghai",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": [
    "qa",
    "bug",
    "feature"
  ],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": true,
  "merge_policy": {
    "default": "human",
    "auto_max_lines": 400,
    "allow_auto_on_production": false
  },
  "migrations": {
    "allowed_envs": [],
    "target_env": "live",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "max_workers": 1,
  "no_progress_cycles": 6,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "verify_commands": [
    "python3 scripts/check_factory.py",
    "python3 -m unittest discover -s tests -v"
  ],
  "usage_fallback": "none",
  "collect": {
    "sources": [
      "github",
      "prs",
      "architecture"
    ],
    "window_days": 14,
    "custom": []
  },
  "notifications": {
    "channel": "session",
    "chat_id": null,
    "bot_identity": "zzsoszz"
  }
}
